<odoo>
    <!-- ACCIONES -->
    <record id="action_cursos" model="ir.actions.act_window">
        <field name="name">Cursos</field>
        <field name="res_model">academica.curso</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_alumnos" model="ir.actions.act_window">
        <field name="name">Alumnos</field>
        <field name="res_model">academica.alumno</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- menu -->
    <menuitem id="menu_gestion_academica" name="Gestión Academica" sequence="10" />
    <menuitem id="menu_cursos" name="Cursos" parent="menu_gestion_academica" action="action_cursos" />
    <menuitem id="menu_alumnos" name="Alumnos" parent="menu_gestion_academica"
        action="action_alumnos" />

    <!-- VISTA -->
    <record id="view_curso_tree" model="ir.ui.view">
        <field name="name">academica.curso.tree</field>
        <field name="model">academica.curso</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="precio" />
                <field name="alumno_ids" />
            </list>
        </field>
    </record>
    <record id="view_curso_form" model="ir.ui.view">
        <field name="name">academica.curso.form</field>
        <field name="model">academica.curso</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name" />
                    <field name="precio" />
                    <field name="alumno_ids" />
                </group>
            </form>
        </field>
    </record>

    <record id="view_curso_tree" model="ir.ui.view">
        <field name="name">academica.alumno.tree</field>
        <field name="model">academica.alumno</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="edad" />
                <field name="coste" />
            </list>
        </field>
    </record>
    <record id="view_curso_form" model="ir.ui.view">
        <field name="name">academica.alumno.form</field>
        <field name="model">academica.alumno</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name" />
                    <field name="edad" />
                    <field name="coste" />
                </group>
            </form>
        </field>
    </record>
</odoo>